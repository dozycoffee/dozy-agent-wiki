POSTGRES_DB=dozy_agent_wiki
POSTGRES_USER=wiki
POSTGRES_PASSWORD=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# org KB 권한 판단 (docs/spec.md §5.1). 둘 다 선택값이지만 실서비스 배포 시 설정 권장 —
# 미설정 시 GITHUB_ORG는 "인증된 사용자는 org read 가능"으로 완화, WIKI_ADMINS는
# "org write 전원 거부"로 안전 기본값 적용.
GITHUB_ORG=
WIKI_ADMINS=

# 로컬 테스트: localhost (Caddy가 내부 CA로 자체 서명 인증서 발급)
# 프로덕션: 실제 도메인 (예: wiki.internal.dozycoffee.com, Caddy가 자동으로 Let's Encrypt 인증서 발급)
DOMAIN=localhost
